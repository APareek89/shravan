# Reused from Blindspot for local development
DATABASE_URL=
ANTHROPIC_API_KEY=

# Supabase Project URL can be derived from DATABASE_URL, but set it explicitly on Render.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Needed to turn on real Supabase email OTP. The app uses a signed demo session without it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional because DATABASE_URL is used for trusted server operations.
# Add it if you later move cron/admin operations to supabase-js.
SUPABASE_SERVICE_ROLE_KEY=

CHECKIN_MODEL=claude-sonnet-4-6
UTILITY_MODEL=claude-haiku-4-5-20251001
DAILY_TOKEN_BUDGET=12000
DAILY_SCAM_MODEL_LIMIT=20
ENABLE_PUBLIC_DEMO=true
CRON_SECRET=
DEMO_SESSION_SECRET=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Guardian email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=Shravan <care@example.com>
